{
	"name": "pi-cliproxyapi-websearch",
	"version": "0.1.1",
	"description": "Zero-configuration native web search injection for CLIProxyAPI in Pi",
	"type": "module",
	"keywords": [
		"pi-package",
		"cliproxyapi",
		"web-search"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/hkfires/pi-cliproxyapi-websearch.git"
	},
	"homepage": "https://github.com/hkfires/pi-cliproxyapi-websearch#readme",
	"bugs": {
		"url": "https://github.com/hkfires/pi-cliproxyapi-websearch/issues"
	},
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"extensions"
	],
	"pi": {
		"extensions": [
			"./extensions/index.ts"
		]
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"scripts": {
		"check": "tsc --noEmit && npm test",
		"test": "node --experimental-strip-types --test test/endpoint.test.ts test/model-selector.test.ts test/sse.test.ts test/search.test.ts test/index.test.ts test/loader.test.ts"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*"
	},
	"devDependencies": {
		"@earendil-works/pi-ai": "^0.85.1",
		"@earendil-works/pi-coding-agent": "0.85.1",
		"@earendil-works/pi-tui": "^0.85.1",
		"@types/node": "22.19.19",
		"typescript": "5.9.3"
	},
	"dependencies": {
		"typebox": "^1.3.33"
	}
}
